:root {
  --bg: #0b1020;
  --surface: #131a2e;
  --surface-elevated: #1a233d;
  --border: rgba(148, 163, 184, 0.16);
  --text: #f1f5f9;
  --text-muted: #94a3b8;
  --accent: #ef4444;
  --accent-soft: rgba(239, 68, 68, 0.18);
  --accent-secondary: #3b82f6;
  --gold: #f59e0b;
  --teal: #14b8a6;
  --radius: 16px;
  --shadow: 0 14px 36px rgba(2, 6, 23, 0.45);
}

body[data-theme="mega645"] {
  --accent: #ef4444;
  --accent-soft: rgba(239, 68, 68, 0.18);
}

body[data-theme="power655"] {
  --accent: #f59e0b;
  --accent-soft: rgba(245, 158, 11, 0.18);
}

body[data-theme="lotto535"] {
  --accent: #10b981;
  --accent-soft: rgba(16, 185, 129, 0.18);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.6;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.bg-glow {
  position: fixed;
  inset: -20% auto auto 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 450px;
  background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
  transition: background 0.35s ease;
}

.container {
  width: min(1160px, 92%);
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 28px 0 18px;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-badge {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--accent), #6366f1);
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 1.05rem;
  color: #fff;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
}

.brand h1 {
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.subtitle {
  font-size: 0.88rem;
  color: var(--text-muted);
}

.meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 0.82rem;
  color: var(--text-muted);
}

.meta-pill .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 8px #22c55e;
}

.tabs-wrapper {
  margin-bottom: 22px;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 6px;
  border-radius: 16px;
}

.tab-btn {
  border: none;
  background: transparent;
  color: var(--text-muted);
  padding: 12px 16px;
  border-radius: 12px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  font-family: inherit;
  transition: all 0.25s ease;
}

.tab-btn:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.04);
}

.tab-btn.active {
  background: var(--surface-elevated);
  color: var(--text);
  box-shadow: inset 0 0 0 1px var(--accent), 0 6px 18px rgba(0, 0, 0, 0.25);
}

.tab-title {
  font-weight: 700;
  font-size: 0.98rem;
}

.tab-sub {
  font-size: 0.76rem;
  color: var(--text-muted);
}

.dashboard {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.fade-in {
  animation: fadeSlide 0.28s ease;
}

@keyframes fadeSlide {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
  box-shadow: var(--shadow);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.card-header h2 {
  font-size: 1.15rem;
  font-weight: 700;
}

.card-header-compact {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.card-header-compact h3 {
  font-size: 1.02rem;
  font-weight: 700;
}

.sub-note {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--text-muted);
}

.card-desc {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 2px;
}

.eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent);
  margin-bottom: 2px;
}

.draw-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 600;
  background: var(--accent-soft);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.chip-muted {
  background: var(--surface-elevated);
  color: var(--text-muted);
}

.chip-outline {
  background: transparent;
  color: var(--text-muted);
}

.balls-stage {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  padding: 8px 0 4px;
}

.ball {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 1.25rem;
  font-weight: 800;
  color: #fff;
  background: radial-gradient(circle at 30% 30%, #ffffff44, transparent 45%),
    linear-gradient(145deg, var(--accent), #1e293b);
  box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4), inset 0 -4px 8px rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.25);
  transition: transform 0.2s ease;
}

.ball:hover {
  transform: translateY(-3px) scale(1.04);
}

.ball-special-wrap {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.ball-plus {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--text-muted);
}

.ball.special {
  background: radial-gradient(circle at 30% 30%, #ffffff55, transparent 45%),
    linear-gradient(145deg, #3b82f6, #7c3aed);
  box-shadow: 0 10px 24px rgba(124, 58, 237, 0.45), inset 0 -4px 8px rgba(0, 0, 0, 0.35);
}

.special-caption {
  font-size: 0.78rem;
  color: #c4b5fd;
  font-weight: 600;
}

.ball-sm {
  width: 36px;
  height: 36px;
  font-size: 0.86rem;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
}

.segmented-control {
  display: inline-flex;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 4px;
  gap: 4px;
}

.seg-btn {
  border: none;
  background: transparent;
  color: var(--text-muted);
  padding: 7px 14px;
  border-radius: 7px;
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.seg-btn.active {
  background: var(--surface-elevated);
  color: var(--text);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.chart-container {
  position: relative;
  height: 320px;
  width: 100%;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.tag {
  font-size: 0.78rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--surface-elevated);
  color: var(--text);
  border: 1px solid var(--border);
}

.ratio-bar-group {
  margin-bottom: 14px;
}

.ratio-labels {
  display: flex;
  justify-content: space-between;
  font-size: 0.86rem;
  font-weight: 600;
  margin-bottom: 6px;
}

.stacked-bar {
  display: flex;
  height: 12px;
  border-radius: 999px;
  overflow: hidden;
  background: var(--bg);
}

.bar-fill {
  height: 100%;
  transition: width 0.4s ease;
}

.bar-primary {
  background: #3b82f6;
}

.bar-secondary {
  background: #ec4899;
}

.bar-teal {
  background: #14b8a6;
}

.bar-amber {
  background: #f59e0b;
}

.pattern-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.pattern-pill {
  font-size: 0.78rem;
  color: var(--text-muted);
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 4px 10px;
  border-radius: 8px;
}

.table-responsive {
  overflow-x: auto;
}

.stats-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

.stats-table th {
  text-align: left;
  color: var(--text-muted);
  font-weight: 600;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 8px 10px;
  border-bottom: 1px solid var(--border);
}

.stats-table td {
  padding: 9px 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  vertical-align: middle;
}

.stats-table tr:last-child td {
  border-bottom: none;
}

.num-badge {
  display: inline-grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-weight: 700;
  font-size: 0.85rem;
  background: var(--surface-elevated);
  border: 1px solid var(--border);
}

.num-badge.hot {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.5);
  color: #fca5a5;
}

.num-badge.cold {
  background: rgba(56, 189, 248, 0.16);
  border-color: rgba(56, 189, 248, 0.45);
  color: #7dd3fc;
}

.suggested-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 22px;
}

.suggested-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  background: var(--surface-elevated);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 16px;
}

.suggested-balls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.suggested-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.generator-box {
  border-top: 1px dashed var(--border);
  padding-top: 20px;
}

.generator-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.generator-controls h3 {
  font-size: 1rem;
  font-weight: 700;
}

.generator-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.select-input {
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  font-family: inherit;
  font-size: 0.86rem;
}

.btn-primary {
  border: none;
  border-radius: 10px;
  padding: 10px 18px;
  font-family: inherit;
  font-size: 0.88rem;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), #6366f1);
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
  transition: transform 0.15s ease, filter 0.2s ease;
}

.btn-primary:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0);
}

.generated-result {
  margin-top: 16px;
  padding: 14px 16px;
  border-radius: 12px;
  background: rgba(99, 102, 241, 0.1);
  border: 1px solid rgba(99, 102, 241, 0.35);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.status-banner {
  background: rgba(245, 158, 11, 0.14);
  border: 1px solid rgba(245, 158, 11, 0.4);
  color: #fde68a;
  padding: 14px 18px;
  border-radius: 12px;
  margin-bottom: 18px;
  font-size: 0.9rem;
}

.hidden {
  display: none !important;
}

.app-footer {
  padding: 26px 0 42px;
}

.disclaimer-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px 20px;
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.65;
}

.disclaimer-box strong {
  color: var(--text);
}

@media (max-width: 820px) {
  .grid-2 {
    grid-template-columns: 1fr;
  }
  .ball {
    width: 48px;
    height: 48px;
    font-size: 1.05rem;
  }
  .chart-container {
    height: 260px;
  }
}

@media (max-width: 520px) {
  .tabs {
    grid-template-columns: 1fr;
  }
}
